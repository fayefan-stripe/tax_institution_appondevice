# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Terminal — the registered reader ID (tmr_...)
STRIPE_READER_ID=tmr_

# Promo code validation
PROMO_CODE=2000
PROMO_VALID_FROM=2026-07-01T00:00:00+10:00
PROMO_VALID_UNTIL=2026-08-31T23:59:59+10:00

# Admin — PIN for logo-tap promo config screen (5 taps on home logo)
ADMIN_PIN=1234

# Server
PORT=3000

# Optional — set on Vercel to your production URL (e.g. https://your-app.vercel.app)
# PUBLIC_BASE_URL=https://your-deployment.example.com

# Vercel Deployment Protection bypass (32-char secret from Dashboard → Deployment Protection)
# Also set on Vercel as env var if simulator-pay.html needs it in pay URLs
# VERCEL_PROTECTION_BYPASS=
